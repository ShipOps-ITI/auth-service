# Application
PORT=5001
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shipops_auth"
JWT_SECRET=replace_me
REFRESH_TOKEN_SECRET=replace_me

# Paymob: use values all from the same Test or Live dashboard mode.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=your_api_key
PAYMOB_SECRET_KEY=your_secret_key
PAYMOB_PUBLIC_KEY=your_public_key
PAYMOB_3DS_INTEGRATION_ID=your_3ds_card_integration_id
PAYMOB_MOTO_INTEGRATION_ID=your_moto_integration_id

# $100.00 monthly. Change both currency and amount only if your Paymob account supports that currency.
PAYMOB_CURRENCY=USD
PAYMOB_PREMIUM_AMOUNT_CENTS=10000

# Must be a public HTTPS URL. Keep the token in the URL; the server checks it before processing a callback.
PAYMOB_WEBHOOK_TOKEN=replace_with_a_long_random_secret
PAYMOB_WEBHOOK_URL=https://api.example.com/api/paymob/webhook?token=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173
# Optional: defaults to FRONTEND_URL/payment/success.
PAYMOB_REDIRECTION_URL=https://app.example.com/payment/success

# Optional: after making the Premium plan once, set this ID so the application never creates another one.
# PAYMOB_PREMIUM_PLAN_ID=12345
